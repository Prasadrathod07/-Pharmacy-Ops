# Application
APP_NAME=Pharmacy Order & Inventory Dashboard
APP_ENV=development
LOG_LEVEL=INFO

# Database
# Full DSN form (optional convenience). If both this and the discrete
# MYSQL_* variables below are provided, backend config decides precedence.
DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:<port>/<database>?ssl-mode=REQUIRED

# Frontend / CORS
FRONTEND_ORIGIN=http://localhost:5173

# Business settings
BUSINESS_TIMEZONE=UTC

# Optional enhancements - leave blank/disabled initially
REDIS_URL=
ENABLE_REALTIME=false

# Discrete MySQL connection variables
MYSQL_HOST=<mysql-host>
MYSQL_PORT=3306
MYSQL_DATABASE=<database-name>
MYSQL_USER=<username>
MYSQL_PASSWORD=<password>
