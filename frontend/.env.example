VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional: subscribe to the backend's SSE stream for live UI updates.
# The backend only actually sends events when its own ENABLE_REALTIME=true;
# this flag independently controls whether the frontend even tries to
# connect. Safe to leave false/unset - the app works fully without it.
VITE_ENABLE_REALTIME=true
